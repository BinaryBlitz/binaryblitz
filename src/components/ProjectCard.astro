---
const { project } = Astro.props;
const { data, id } = project;
const textColor = data.text_color_theme === 'dark' ? 'text-gray-900' : 'text-white';
---

<a href={`/projects/${id}`}
  class:list={['group bg-cover p-10 xl:p-12 flex flex-col justify-between items-start gap-y-12 md:gap-y-8 lg:gap-y-14 xl:gap-y-20 focus-visible:-outline-offset-4', textColor]}
  style={{ backgroundImage: `url(${data.background_url})` }}>
  <img alt="" src={data.icon_src} class="h-12" />
  <div class="space-y-1 font-medium">
    <p class="text-sm">{data.category}</p>
    <p class="text-lg leading-6 font-semibold underline-offset-4 group-hover:underline">{data.headline}</p>
  </div>
</a>
